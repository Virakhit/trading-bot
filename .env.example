MODE=paper
EXECUTION_BACKEND=local-paper
AUTOMATED_WEBULL_TEST_ENABLED=false
SESSION_TIMEZONE=Asia/Bangkok
DATABASE_URL=sqlite:///data/research.db
INITIAL_CASH=10000
SLIPPAGE_BPS=2
FEE_PER_SHARE=0.005
MAX_POSITION_SIZE=100
MAX_POSITION_PCT=0.25
MAX_SYMBOL_EXPOSURE=2500
MAX_DAILY_LOSS=200
MAX_TRADES_PER_DAY=20
MAX_CONCURRENT_POSITIONS=5
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.05
LOSS_STREAK_LIMIT=3
COOLDOWN_SECONDS=300
KILL_SWITCH=false

# Optional Webull Thailand TEST credentials. Keep secrets only in local .env.
WEBULL_TEST_APP_KEY=replace-with-test-app-key
WEBULL_TEST_APP_SECRET=replace-with-test-app-secret
WEBULL_TEST_ACCOUNT_ID=replace-with-test-account-id
